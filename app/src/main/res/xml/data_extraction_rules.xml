<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above: same idea, cloud or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lumina-library.db" />
        <include domain="sharedpref" path="lumina.xml" />
        <include domain="file" path="covers/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lumina-library.db" />
        <include domain="sharedpref" path="lumina.xml" />
        <include domain="file" path="covers/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
