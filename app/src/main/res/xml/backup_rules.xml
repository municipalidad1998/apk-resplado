    <include domain="database" path="lumina-library.db" />
    <include domain="database" path="lumina-library.db-wal" />
    <include domain="database" path="lumina-library.db-shm" />
    <include domain="sharedpref" path="lumina.xml" />
    <include domain="file" path="covers/" />
</full-backup-content>
