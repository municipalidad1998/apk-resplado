<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous" android:tint="@color/text_primary"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Agregar Fuente"
            android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
        <Button android:id="@+id/tabM3uUrl" style="@style/TabButton"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:selected="true" android:text="URL M3U"/>
        <Button android:id="@+id/tabXtream" style="@style/TabButton"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:text="Xtream"/>
        <Button android:id="@+id/tabFile" style="@style/TabButton"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:text="Archivo"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- M3U URL Panel -->
            <LinearLayout android:id="@+id/panelM3uUrl" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Nombre de la lista" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etM3uName" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="Ej: Mi IPTV" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="12dp" android:inputType="text"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="URL de la lista M3U" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etM3uUrl" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="http://..." android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:inputType="textUri" android:layout_marginBottom="16dp"/>
                <Button android:id="@+id/btnAddM3u" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/btn_primary"
                    android:text="AGREGAR LISTA M3U" android:textColor="#FFFFFF" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Xtream Panel -->
            <LinearLayout android:id="@+id/panelXtream" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Nombre" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etXtreamName" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="Mi servidor" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp" android:inputType="text"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="URL del servidor" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etXtreamUrl" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="http://servidor:puerto" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:inputType="textUri" android:layout_marginBottom="10dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Usuario" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etXtreamUser" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="username" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="10dp" android:inputType="text"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Contrasena" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etXtreamPass" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="password" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:inputType="textPassword" android:layout_marginBottom="16dp"/>
                <Button android:id="@+id/btnAddXtream" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/btn_primary"
                    android:text="AGREGAR XTREAM CODES" android:textColor="#FFFFFF" android:textStyle="bold"/>
            </LinearLayout>

            <!-- File Panel -->
            <LinearLayout android:id="@+id/panelFile" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Nombre (opcional)" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/etFileName" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/input_bg"
                    android:hint="Mi lista local" android:textColor="@color/text_primary"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp" android:inputType="text"/>
                <Button android:id="@+id/btnPickFile" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="@drawable/btn_secondary"
                    android:text="SELECCIONAR ARCHIVO .M3U"
                    android:textColor="@color/accent_cyan" android:textStyle="bold"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_surface"
                android:layout_marginTop="20dp" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Fuentes guardadas:" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvSourcesList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text_primary"
                android:textSize="14sp" android:lineSpacingExtra="6dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
