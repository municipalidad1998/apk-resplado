<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:background="@color/bg_dark">
    <View android:layout_width="3dp" android:layout_height="18dp"
        android:background="#0066FF" android:layout_marginEnd="10dp"/>
    <TextView android:id="@+id/tvHeader"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
        android:letterSpacing="0.08"/>
    <TextView android:id="@+id/tvHeaderCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#8888AA" android:textSize="11sp"/>
</LinearLayout>
