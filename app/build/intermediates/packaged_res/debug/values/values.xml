<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#0066FF</color>
    <color name="accent_cyan">#00C8FF</color>
    <color name="accent_glow">#1A4FFF</color>
    <color name="bg_card">#12121A</color>
    <color name="bg_dark">#0A0A0F</color>
    <color name="bg_surface">#1A1A26</color>
    <color name="live_badge">#FF3B3B</color>
    <color name="tab_normal">#2A2A3A</color>
    <color name="tab_selected">#0066FF</color>
    <color name="text_muted">#444466</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#8888AA</color>
    <color name="transparent">#00000000</color>
    <string name="add_source">Agregar Fuente</string>
    <string name="app_name">StreamVault</string>
    <string name="live">En Vivo</string>
    <string name="movies">Películas</string>
    <string name="no_content">Sin contenido. Agrega una fuente primero.</string>
    <string name="series">Series</string>
    <string name="sources">Mis Fuentes</string>
    <style name="DarkDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TabButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/tab_selector</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="strokeColor">@color/transparent</item>
    </style>
    <style name="TelegramInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">#666688</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Theme.StreamVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
    <style name="Theme.StreamVault.Player" parent="Theme.StreamVault">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.StreamVault.Splash" parent="Theme.StreamVault">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>