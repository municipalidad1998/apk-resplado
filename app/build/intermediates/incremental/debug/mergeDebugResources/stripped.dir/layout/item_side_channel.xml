<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp">

    <!-- Indicador reproduciendo -->
    <View android:id="@+id/viewPlaying"
        android:layout_width="3dp" android:layout_height="36dp"
        android:background="#0066FF"
        android:layout_marginEnd="8dp"/>

    <ImageView android:id="@+id/imgLogo"
        android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="centerCrop"
        android:background="@drawable/logo_bg"
        android:layout_marginEnd="10dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#8888AA" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
